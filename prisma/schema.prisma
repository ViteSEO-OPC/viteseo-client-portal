generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

enum ClientStatus {
  active
  inactive
  archived
}

enum QuoteStatus {
  draft
  sent
  viewed
  accepted
  rejected
  expired
  superseded
}

model Client {
  id           String       @id @default(uuid()) @db.Uuid
  companyName  String       @map("company_name") @db.VarChar(255)
  contactName  String       @map("contact_name") @db.VarChar(255)
  email        String       @db.VarChar(255) // Encrypted at application level
  portalSlug   String       @unique @map("portal_slug") @db.VarChar(100)
  status       ClientStatus @default(active)
  timezone     String       @default("UTC") @db.VarChar(50)
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime     @updatedAt @map("updated_at") @db.Timestamptz

  quotes      Quote[]
  accessCodes AccessCode[]
  sessions    Session[]

  @@map("clients")
}

model Quote {
  id              String      @id @default(uuid()) @db.Uuid
  clientId        String      @map("client_id") @db.Uuid
  quoteNumber     String      @unique @map("quote_number") @db.VarChar(50)
  version         Int         @default(1)
  previousQuoteId String?     @map("previous_quote_id") @db.Uuid
  status          QuoteStatus @default(draft)
  validUntil      DateTime    @map("valid_until") @db.Timestamptz
  total           Decimal     @db.Decimal(12, 2)
  currency        String      @default("PHP") @db.VarChar(3)
  notes           String?     @db.Text
  contentHash     String?     @map("content_hash") @db.VarChar(64)
  routePath       String?     @map("route_path") @db.VarChar(255) // Path to custom quote page
  createdAt       DateTime    @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime    @updatedAt @map("updated_at") @db.Timestamptz

  client        Client           @relation(fields: [clientId], references: [id], onDelete: Cascade)
  previousQuote Quote?           @relation("QuoteVersions", fields: [previousQuoteId], references: [id])
  nextQuotes    Quote[]          @relation("QuoteVersions")
  items         QuoteItem[]
  pdfTokens     PdfRenderToken[]
  accessCodes   AccessCode[]

  @@index([clientId, status], name: "idx_quotes_client")
  @@index([createdAt], name: "idx_quotes_created")
  @@map("quotes")
}

model QuoteItem {
  id          String   @id @default(uuid()) @db.Uuid
  quoteId     String   @map("quote_id") @db.Uuid
  name        String   @db.VarChar(255)
  description String?  @db.Text
  quantity    Int      @default(1)
  unitPrice   Decimal  @map("unit_price") @db.Decimal(12, 2)
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  quote Quote @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@index([quoteId], name: "idx_quote_items_quote")
  @@map("quote_items")
}

model AccessCode {
  id             String    @id @default(uuid()) @db.Uuid
  clientId       String?   @map("client_id") @db.Uuid
  quoteId        String?   @map("quote_id") @db.Uuid
  code           String    @unique @db.VarChar(20) // Plain code for manual entry (e.g., "ACME2024")
  clientSlug     String    @map("client_slug") @db.VarChar(100) // Maps to clients/ folder
  codeHash       String?   @map("code_hash") @db.VarChar(255) // Optional hashed version
  codeHint       String?   @map("code_hint") @db.VarChar(4)
  isActive       Boolean   @default(true) @map("is_active")
  expiresAt      DateTime? @map("expires_at") @db.Timestamptz
  maxUses        Int       @default(100) @map("max_uses")
  usedCount      Int       @default(0) @map("used_count")
  failedAttempts Int       @default(0) @map("failed_attempts")
  lockedUntil    DateTime? @map("locked_until") @db.Timestamptz
  revokedAt      DateTime? @map("revoked_at") @db.Timestamptz
  revokedBy      String?   @map("revoked_by") @db.VarChar(255)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz

  client   Client?   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  quote    Quote?    @relation(fields: [quoteId], references: [id])
  sessions Session[]

  @@index([code], name: "idx_codes_lookup")
  @@index([clientSlug], name: "idx_codes_slug")
  @@index([clientId], name: "idx_codes_client")
  @@map("access_codes")
}

model Session {
  id           String    @id @default(uuid()) @db.Uuid
  clientId     String    @map("client_id") @db.Uuid
  accessCodeId String    @map("access_code_id") @db.Uuid
  tokenHash    String    @unique @map("token_hash") @db.VarChar(64)
  ipAddress    String    @map("ip_address") @db.VarChar(45)
  userAgent    String?   @map("user_agent") @db.Text
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz
  revokedAt    DateTime? @map("revoked_at") @db.Timestamptz
  lastActiveAt DateTime  @default(now()) @map("last_active_at") @db.Timestamptz
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz

  client     Client     @relation(fields: [clientId], references: [id], onDelete: Cascade)
  accessCode AccessCode @relation(fields: [accessCodeId], references: [id])

  @@index([tokenHash], name: "idx_sessions_token")
  @@index([clientId, expiresAt], name: "idx_sessions_client")
  @@index([expiresAt], name: "idx_sessions_expires")
  @@map("sessions")
}

model PdfRenderToken {
  id        String    @id @default(uuid()) @db.Uuid
  quoteId   String    @map("quote_id") @db.Uuid
  clientId  String    @map("client_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.VarChar(64)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz
  usedAt    DateTime? @map("used_at") @db.Timestamptz
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz

  quote Quote @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@index([tokenHash, expiresAt], name: "idx_pdf_tokens_lookup")
  @@map("pdf_render_tokens")
}

model AuditLog {
  id           String   @id @default(uuid()) @db.Uuid
  eventType    String   @map("event_type") @db.VarChar(50)
  actorType    String   @map("actor_type") @db.VarChar(20)
  actorId      String?  @map("actor_id") @db.VarChar(255)
  action       String   @db.VarChar(255)
  resourceType String?  @map("resource_type") @db.VarChar(50)
  resourceId   String?  @map("resource_id") @db.Uuid
  ipAddress    String?  @map("ip_address") @db.VarChar(45)
  userAgent    String?  @map("user_agent") @db.Text
  meta         Json?    @db.JsonB
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([actorType, actorId], name: "idx_audit_actor")
  @@index([eventType, createdAt], name: "idx_audit_event")
  @@index([resourceType, resourceId], name: "idx_audit_resource")
  @@index([createdAt], name: "idx_audit_created")
  @@map("audit_logs")
}

model PdfCache {
  id          String   @id @default(uuid()) @db.Uuid
  quoteId     String   @map("quote_id") @db.Uuid
  contentHash String   @map("content_hash") @db.VarChar(64)
  pdfData     Bytes    @map("pdf_data")
  fileSize    Int      @map("file_size")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  expiresAt   DateTime @map("expires_at") @db.Timestamptz

  @@unique([quoteId, contentHash])
  @@index([expiresAt], name: "idx_pdf_cache_expires")
  @@map("pdf_cache")
}

model AdminPreviewToken {
  id         String    @id @default(uuid()) @db.Uuid
  quoteId    String    @map("quote_id") @db.Uuid
  clientSlug String    @map("client_slug") @db.VarChar(100)
  adminId    String    @map("admin_id") @db.VarChar(255) // Clerk user ID
  tokenHash  String    @unique @map("token_hash") @db.VarChar(64)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz
  usedAt     DateTime? @map("used_at") @db.Timestamptz
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz

  @@index([tokenHash, expiresAt], name: "idx_admin_preview_tokens_lookup")
  @@map("admin_preview_tokens")
}
